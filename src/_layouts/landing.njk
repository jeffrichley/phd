---
layout: base.njk
---
<article class="landing">
  <header class="page-header">
    <h1>{{ site.title }}</h1>
    <p class="lead">{{ site.subtitle }}</p>
  </header>

  {% if hero %}
  <figure class="video hero">
    <video controls muted loop playsinline preload="metadata" src="/assets/video/{{ hero }}"></video>
    {% if heroCaption %}<figcaption>{{ heroCaption }}</figcaption>{% endif %}
  </figure>
  {% endif %}

  {{ content | safe }}

  <div class="card-grid">
    {%- for p in collections.pages %}
    <a class="card" href="{{ p.url }}">
      <h3>{{ p.data.title }}</h3>
      <p>{{ p.data.teaser }}</p>
    </a>
    {%- endfor %}
    <a class="card" href="/notes/">
      <h3>Lab Notes</h3>
      <p>Dated record of results, findings, and decisions — newest first.</p>
    </a>
  </div>

  {% set latest = collections.notes | reverse %}
  {% if collections.notes.length > 0 %}
  <h2>Latest from the lab</h2>
  {%- for n in collections.notes.slice(0, 3) %}
  <div class="note-card">
    <p class="note-meta">{{ n.date.toISOString().slice(0, 10) }} · <span class="tag">{{ n.data.tag }}</span></p>
    <h3><a href="{{ n.url }}">{{ n.data.title }}</a></h3>
    <p>{{ n.data.excerpt }}</p>
  </div>
  {%- endfor %}
  {% endif %}
</article>
