<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex">
  <title>{% if title %}{{ title }} · {% endif %}{{ site.title }}</title>
  <link rel="stylesheet" href="/assets/tokens.css">
  <link rel="stylesheet" href="/assets/site.css">
</head>
<body>
  <header class="site-header">
    <a class="site-name" href="/">{{ site.title }}</a>
    <nav class="site-nav">
      {%- for p in collections.pages %}
      <a href="{{ p.url }}"{% if p.url == page.url %} aria-current="page"{% endif %}>{{ p.data.title }}</a>
      {%- endfor %}
      <a href="/notes/"{% if '/notes/' in page.url %} aria-current="page"{% endif %}>Lab Notes</a>
    </nav>
  </header>
  <main>
    {{ content | safe }}
  </main>
  <footer class="site-footer">
    <p>Jeff Richley · ODU MAE PhD · advisor Krishnanand Kaipa, CRAMLab</p>
  </footer>
</body>
</html>
