---
layout: base.njk
---
<article class="page">
  <header class="page-header">
    <h1>{{ title }}</h1>
    {% if lead %}<p class="lead">{{ lead }}</p>{% endif %}
  </header>
  {{ content | safe }}
  {% set prevPage = collections.pages | getPreviousCollectionItem %}
  {% set nextPage = collections.pages | getNextCollectionItem %}
  <nav class="page-footer-nav">
    {% if prevPage %}<a class="prev" href="{{ prevPage.url }}">&larr; {{ prevPage.data.title }}</a>{% endif %}
    {% if nextPage %}<a class="next" href="{{ nextPage.url }}">{{ nextPage.data.title }} &rarr;</a>{% endif %}
  </nav>
</article>
