---
layout: base.njk
title: Lab Notes
permalink: /notes/
---
<article class="page">
  <header class="page-header">
    <h1>Lab Notes</h1>
    <p class="lead">Dated record of results, findings, and decisions — newest first.</p>
  </header>
  {%- for n in collections.notes %}
  <div class="note-card">
    <p class="note-meta">{{ n.date.toISOString().slice(0, 10) }} · <span class="tag">{{ n.data.tag }}</span></p>
    <h3><a href="{{ n.url }}">{{ n.data.title }}</a></h3>
    <p>{{ n.data.excerpt }}</p>
  </div>
  {%- endfor %}
</article>
